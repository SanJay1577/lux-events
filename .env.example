# Server-only Netlify Function variables. Never prefix these with VITE_ or commit real values.
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Optional tab names. These defaults match the setup guide.
CONTACT_SHEET_NAME=Contact Form
NEWSLETTER_SHEET_NAME=Newsletter
